# Primary: DeepSeek direct (https://platform.deepseek.com/) — needs paid balance
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Fallback when DeepSeek returns 402 (no credits): OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Optional: comma-separated OpenRouter models (tries in order)
# OPENROUTER_MODELS=deepseek/deepseek-v4-flash:free,deepseek/deepseek-chat:free,openrouter/free

# Optional
# DEEPSEEK_MODEL=deepseek-reasoner
# DEEPSEEK_PARSE_MODEL=deepseek-chat
# AI_PROVIDER=openrouter
# PYTHON_PATH=py
PORT=3000
